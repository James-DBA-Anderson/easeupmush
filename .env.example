# Copy this to `.env` and fill in one or both sets of keys.
# AI backends are tried in this order: Cloudflare Workers AI → OpenRouter.
# Any game that needs a local AI will pick up `OPENROUTER_API_KEY` automatically.

# -- Cloudflare Workers AI (used on the live worker)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_MODEL=@cf/meta/llama-3.2-3b-instruct

# -- OpenRouter (cheap local dev / any model via free tier)
OPENROUTER_API_KEY=
# Optional: change the model. Defaults to anthropic/claude-3.5-haiku.
# OPENROUTER_MODEL=anthropic/claude-3.5-haiku
