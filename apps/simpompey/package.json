{
  "name": "@easeupmush/simpompey",
  "version": "0.1.0",
  "private": true,
  "description": "SimPompey — an interactive 3D map of Portsmouth with real open-data overlays.",
  "type": "module",
  "scripts": {
    "dev": "sh -c 'fuser -k 5308/tcp >/dev/null 2>&1 || true; node ./scripts/ensure-terrain.mjs && exec vite'",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./dialogue": "./src/dialogue/index.ts"
  },
  "dependencies": {
    "@easeupmush/shared": "*",
    "three": "^0.170.0",
    "three-mesh-bvh": "^0.9.18"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  }
}
