{
  "name": "@easeupmush/osm-terrain-build",
  "version": "0.1.0",
  "private": true,
  "description": "Pipeline: SRTM DEM + OSM → GLB terrain for SimPompey",
  "type": "module",
  "scripts": {
    "fetch": "tsx fetch-osm.ts",
    "fetch-osm": "tsx fetch-osm.ts",
    "build": "tsx stream.ts && cp data/portsmouth-terrain.gltf data/portsmouth-terrain.bin data/portsmouth-labels.json data/portsmouth-harbour.json data/portsmouth-power.json data/portsmouth-barriers.json ../../apps/simpompey/public/models/",
    "trees": "tsx trees.ts",
    "trees:off-road": "tsx trees.ts --off-road",
    "ships": "tsx ships.ts",
    "trains": "tsx trains.ts",
    "os-buildings": "tsx os-buildings.ts",
    "gardens": "tsx gardens.ts",
    "coast": "tsx coast.ts",
    "furniture": "tsx furniture.ts",
    "places": "tsx places.ts",
    "zones": "tsx zones.ts",
    "land-value": "tsx land-value.ts",
    "traffic": "tsx traffic.ts",
    "crime": "tsx crime.ts",
    "pollution": "tsx pollution.ts",
    "flood": "tsx flood.ts",
    "imd": "tsx deprivation.ts",
    "broadband": "tsx broadband.ts",
    "terrain": "npm run fetch && npm run build"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.5",
    "earcut": "^2.2.4",
    "geotiff": "^2.1.3",
    "proj4": "^2.22.0",
    "three": "^0.175.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.8.2"
  }
}
